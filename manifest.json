{
    "manifest_version": 2,
    "description": "20-20-20",
    "name":"Eye Extension",
    "version": "1.0",
    "browser_action":{
        "default_icon": {
            "19": "icon.png"
        },
        "default_popup":"popup.html"
    },
    "content_scripts": [
        {
            "matches":["<all_urls>"],
            "js":["content.js"]
        }
    ],
    "permissions": ["tabs"],

    "web_accessible_resources": ["*.html"],

    "content_security_policy": "script-src 'self' 'sha256-/13BBW2yQVtpCsBV7JiO23y7pwEFFUobOzefJ27Nltg='; object-src 'self'"
    
   
}